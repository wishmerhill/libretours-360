{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core, file system access limited to $APPDATA/projects and $APPDATA/themes, native open/save dialogs",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:path:default",
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$APPDATA/projects"
        },
        {
          "path": "$APPDATA/projects/**"
        },
        {
          "path": "$APPDATA/themes"
        },
        {
          "path": "$APPDATA/themes/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "$APPDATA/projects"
        },
        {
          "path": "$APPDATA/projects/**"
        },
        {
          "path": "$APPDATA/themes"
        },
        {
          "path": "$APPDATA/themes/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "$APPDATA/projects"
        },
        {
          "path": "$APPDATA/projects/**"
        },
        {
          "path": "$APPDATA/themes"
        },
        {
          "path": "$APPDATA/themes/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "$APPDATA/projects"
        },
        {
          "path": "$APPDATA/projects/**"
        },
        {
          "path": "$APPDATA/themes"
        },
        {
          "path": "$APPDATA/themes/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$APPDATA/projects"
        },
        {
          "path": "$APPDATA/projects/**"
        },
        {
          "path": "$APPDATA/themes"
        },
        {
          "path": "$APPDATA/themes/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "$APPDATA/projects"
        },
        {
          "path": "$APPDATA/projects/**"
        },
        {
          "path": "$APPDATA/themes"
        },
        {
          "path": "$APPDATA/themes/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$APPDATA/projects"
        },
        {
          "path": "$APPDATA/projects/**"
        },
        {
          "path": "$APPDATA/themes"
        },
        {
          "path": "$APPDATA/themes/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "$APPDATA/projects"
        },
        {
          "path": "$APPDATA/projects/**"
        },
        {
          "path": "$APPDATA/themes"
        },
        {
          "path": "$APPDATA/themes/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        {
          "path": "$APPDATA/projects"
        },
        {
          "path": "$APPDATA/projects/**"
        },
        {
          "path": "$APPDATA/themes"
        },
        {
          "path": "$APPDATA/themes/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        {
          "path": "$APPDATA/projects"
        },
        {
          "path": "$APPDATA/projects/**"
        }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:default",
    "opener:allow-open-url",
    "opener:allow-open-path"
  ]
}
