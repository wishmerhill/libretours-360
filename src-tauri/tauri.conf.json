{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LibreTours 360",
  "version": "0.1.0",
  "identifier": "com.libretours.studio",
  "build": {
    "beforeBuildCommand": "npx vite build --config vite.tauri.config.ts",
    "beforeDevCommand": "npx vite --config vite.tauri.config.ts",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LibreTours 360",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/projects/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
  
}